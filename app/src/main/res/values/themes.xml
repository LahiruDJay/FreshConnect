<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FreshConnect" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryDark">@color/primary_green_dark</item>
        <item name="colorAccent">@color/primary_green</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Bottom Navigation customization -->
        <item name="bottomNavigationStyle">@style/BottomNavStyle</item>
    </style>

    <style name="Theme.FreshConnect" parent="Base.Theme.FreshConnect" />

    <!-- BottomNavigationView: clean flat style like the reference image -->
    <style name="BottomNavStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <!-- Remove the Material3 indicator pill/background highlight -->
        <item name="itemActiveIndicatorStyle">@style/NavIndicatorHidden</item>
    </style>

    <!-- Make the active indicator invisible (no pill/bubble behind icon) -->
    <style name="NavIndicatorHidden">
        <item name="android:color">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.None</item>
    </style>

    <!-- Login screen specific styles -->
    <style name="LoginInputStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/selector_input_field</item>
        <item name="android:paddingStart">48dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>