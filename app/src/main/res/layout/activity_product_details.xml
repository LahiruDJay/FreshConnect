<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomActionBar"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header containing full-bleed Product Image and Back button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpProductImages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivDetailImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/food"
                    android:contentDescription="Product Image" />

                <TextView
                    android:id="@+id/tvImageIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_indicator_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:text="1/1"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="20dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="@drawable/bg_category_circle"
                    android:elevation="4dp"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    app:tint="#1C1C1C"
                    android:contentDescription="Back" />
            </RelativeLayout>

            <!-- Product Details Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Row: Category & Bookmark -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvDetailCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vegetable"
                        android:textSize="12sp"
                        android:textColor="#10B981"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_category_pill"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <ImageButton
                        android:id="@+id/btnBookmark"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_bookmark"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:tint="#888888"
                        android:contentDescription="Bookmark" />
                </RelativeLayout>

                <!-- Product Name -->
                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tomatoes – Local Variety"
                    android:textSize="20sp"
                    android:textColor="#1C1C1C"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginBottom="10dp" />

                <!-- Price and Unit -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/tvDetailPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rs. 120"
                        android:textSize="18sp"
                        android:textColor="#10B981"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/tvDetailUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" / per kg"
                        android:textSize="14sp"
                        android:textColor="#888888"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="1dp" />
                </LinearLayout>

                <!-- Description Heading -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="16sp"
                    android:textColor="#1C1C1C"
                    android:fontFamily="sans-serif-bold"
                    android:layout_marginBottom="8dp" />

                <!-- Description Body -->
                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fresh home-grown tomatoes from my garden. No chemicals used. Perfect for salads and curries."
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginBottom="24dp" />

                <!-- Additional Information Heading -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Additional Information"
                    android:textSize="16sp"
                    android:textColor="#1C1C1C"
                    android:fontFamily="sans-serif-bold"
                    android:layout_marginBottom="12dp" />

                <!-- Qty Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quantity:"
                        android:textSize="14sp"
                        android:textColor="#888888" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvDetailQty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25 kg"
                        android:textSize="14sp"
                        android:textColor="#1C1C1C"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Posted On Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Posted on:"
                        android:textSize="14sp"
                        android:textColor="#888888" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvDetailPostedOn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22 November 2025"
                        android:textSize="14sp"
                        android:textColor="#1C1C1C"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Seller Profile Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_seller_card"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF"
                        android:layout_gravity="center">

                        <ImageView
                            android:id="@+id/ivSellerAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_person"
                            android:scaleType="centerCrop"
                            android:contentDescription="Seller Avatar" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvSellerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nimal Jayasinghe"
                            android:textSize="15sp"
                            android:textColor="#1C1C1C"
                            android:fontFamily="sans-serif-bold" />

                        <TextView
                            android:id="@+id/tvSellerJoined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Joined in 2023"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions layout (Floating Action Bar) -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewOnMap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_outlined_button"
            android:text="Location"
            android:textColor="#555555"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-bold"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContactSeller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_green_button"
            android:text="Chat"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-bold"
            android:textSize="14sp" />

    </LinearLayout>

</RelativeLayout>
