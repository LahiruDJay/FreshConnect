<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Green Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_home_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Welcome & Notification Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome 👋"
                    android:textSize="14sp"
                    android:textColor="#E8F5E9"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guest User"
                    android:textSize="22sp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNotification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_notifications"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:tint="#FFFFFF"
                android:contentDescription="Notifications" />

        </RelativeLayout>

        <!-- Search Bar Inside Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/selector_input_field"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="6dp"
            android:layout_marginTop="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#888888" />

            <EditText
                android:id="@+id/searchBar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Search for fresh items..."
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp"
                android:inputType="text"
                android:imeOptions="actionSearch" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_search_button"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#FFFFFF"
                android:contentDescription="Search button" />
        </LinearLayout>
    </LinearLayout>

    <!-- Category Section -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingVertical="4dp"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Category: All -->
            <LinearLayout
                android:id="@+id/catAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:id="@+id/frameAll"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_category_circle"
                    android:elevation="3dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/food"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textSize="13sp"
                    android:textColor="#4A4A4A"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Category: Vegetables -->
            <LinearLayout
                android:id="@+id/catVegetables"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:id="@+id/frameVegetables"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_category_circle"
                    android:elevation="3dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/vegetable"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vegetables"
                    android:textSize="13sp"
                    android:textColor="#4A4A4A"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Category: Fruits -->
            <LinearLayout
                android:id="@+id/catFruits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:id="@+id/frameFruits"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_category_circle"
                    android:elevation="3dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/fruits"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fruits"
                    android:textSize="13sp"
                    android:textColor="#4A4A4A"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Category: Herbs -->
            <LinearLayout
                android:id="@+id/catHerbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:id="@+id/frameHerbs"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_category_circle"
                    android:elevation="3dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/spices"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Herbs"
                    android:textSize="13sp"
                    android:textColor="#4A4A4A"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Category: Seeds & Plants -->
            <LinearLayout
                android:id="@+id/catSeeds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <FrameLayout
                    android:id="@+id/frameSeeds"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_category_circle"
                    android:elevation="3dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/seed_bag"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seeds &amp; Plants"
                    android:textSize="13sp"
                    android:textColor="#4A4A4A"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Products Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fresh Products"
        android:textSize="18sp"
        android:textColor="#1C1C1C"
        android:fontFamily="sans-serif-black"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <!-- Products RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:scrollbars="none" />

</LinearLayout>
